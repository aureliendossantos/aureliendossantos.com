# Copy to .env and fill in. The full list of server secrets the site can use is
# the `env.schema` block in astro.config.ts; only the ones below are needed for
# the /fit assessment feature.

# ── Fit assessment (/fit) ────────────────────────────────────────────────────
# Server-only. Without it the site still builds and /fit still renders, but the
# endpoint returns 503 and the page shows a friendly "not available" message.
# Set a spending limit on the OpenAI project this key belongs to.
OPENAI_API_KEY=

# Optional. Overrides model selection, which otherwise resolves to:
#   local dev        → gpt-5.6-luna
#   Vercel Preview   → gpt-5.6-luna
#   Vercel Prod      → gpt-5.6-sol
# AI_MATCH_MODEL=gpt-5.6-luna

# ── Content submodule ────────────────────────────────────────────────────────
# Used by scripts/writeGitmodules.ts to fetch the private content submodule.
GITHUB_TOKEN=

# ── Catalogue database ───────────────────────────────────────────────────────
CATALOGUE_DB_URL=

# ── Remote data sources used at build time ───────────────────────────────────
GOOGLE_MAPS_TOKEN=
TWITCH_ID=
TWITCH_SECRET=
DISCOGS_PERSONAL_ACCESS_TOKEN=
NOTION_SECRET=
NOTION_GAMES_DB=
NOTION_WIKI_PAGES_DB=
TMDB_READ_ACCESS_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
